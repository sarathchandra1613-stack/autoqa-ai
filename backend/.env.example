# offline = no API cost (default). gemini = use Gemini API.
GENERATION_MODE=offline

# When GENERATION_MODE=gemini, fall back to offline templates on quota errors.
GEMINI_FALLBACK_OFFLINE=true

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_HTTP_TIMEOUT_S=30
GEMINI_MAX_OUTPUT_TOKENS=1200
